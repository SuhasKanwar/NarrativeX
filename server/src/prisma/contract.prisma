// use prisma-8

enum AuthProvider {
  GOOGLE
  CREDENTIALS
}

enum Sender {
  user
  bot
  system
}

enum ChatType {
  text
}

enum ConversationVariant {
  chat
}

model User {
  id        Char(24) @id @default(cuid(2))
  email     String   @unique
  name      String?
  imageUrl  String?
  password  String?
  provider  AuthProvider
  
  createdAt TimestamptzString @default(now())
  updatedAt TimestamptzString @default(now())

  conversations Conversation[]

  @@index([email])
  @@index([createdAt])
}

model Conversation {
  id          Char(36)            @id @default(uuid())
  userId      Char(24)
  title       String?
  variant     ConversationVariant @default(chat)
  startedAt   TimestamptzString  @default(now())
  lastUpdated TimestamptzString  @default(now())

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  chats Chat[]

  @@index([userId])
  @@index([lastUpdated])
}

model Chat {
  id                 Char(36) @id @default(uuid())
  type               ChatType @default(text)
  conversationId     Char(36)
  sender             Sender
  content            String?
  createdAt          TimestamptzString @default(now())
  updatedAt          TimestamptzString @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([createdAt])
  @@index([sender])
}
